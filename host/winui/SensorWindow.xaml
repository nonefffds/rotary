<Window
    x:Class="RotaryMonitor.SensorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="20" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="StatusText" Foreground="Gray" Text="..."/>
        <TextBlock x:Name="AngleText" Grid.Row="1" FontSize="44" FontWeight="Bold"
                   HorizontalAlignment="Center" Text="--°"/>
        <Canvas x:Name="Dial" Grid.Row="2" Width="240" Height="240" HorizontalAlignment="Center"/>
        <TextBlock x:Name="StateText" Grid.Row="3" FontSize="14" FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBlock x:Name="RawText" Grid.Row="4" FontFamily="Consolas" FontSize="12"
                   HorizontalAlignment="Center" Foreground="Gray"/>
        <TextBlock x:Name="NoteText" Grid.Row="5" Foreground="Gray" HorizontalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
    </Grid>
</Window>
